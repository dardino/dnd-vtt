{
  "name": "@dnd-vtt/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@dnd-vtt/shared": "0.1.0",
    "@ngrx/signals": "22.0.1",
    "konva": "10.9.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "1.64.1",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
