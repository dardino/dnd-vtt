{
  "name": "dnd-vtt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "workspaces": [
    "client",
    "shared",
    "server"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "prepare": "node scripts/install-hooks.mjs",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "check": "turbo run lint typecheck test build && npm run db:check && npm run check:bundles -w @dnd-vtt/server",
    "files:report": "node scripts/files-report.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "srd:import": "node server/scripts/import-srd.mjs",
    "db:generate": "npm run db:generate -w @dnd-vtt/server",
    "db:migrate": "npm run db:migrate -w @dnd-vtt/server",
    "db:seed": "npm run db:seed -w @dnd-vtt/server",
    "db:reset": "npm run db:reset -w @dnd-vtt/server",
    "db:check": "npm run db:check -w @dnd-vtt/server",
    "hash:password": "npm run hash:password -w @dnd-vtt/server"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.6",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
