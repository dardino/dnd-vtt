{
  "name": "dnd-vtt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "client",
    "shared",
    "server"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "srd:import": "node server/scripts/import-srd.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "jsdom": "30.0.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
