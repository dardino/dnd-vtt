NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Password DM. Fuori dal loopback ne serve una tra DM_PASSWORD e
# DM_PASSWORD_HASH, e la password in chiaro deve avere almeno 12 caratteri.
# Consigliato: `npm run hash:password` e incolla qui l'hash (ha precedenza).
# In Docker/Compose racchiudi l'hash tra apici singoli: 'scrypt$...$...'
DM_PASSWORD=
DM_PASSWORD_HASH=
SESSION_SECRET=
COOKIE_SECURE=auto
# Reverse proxy TLS (Caddy/nginx): false = nessun proxy (default), true = fidati
# di qualsiasi proxy, 1..10 = numero di hop fidati. Con un solo proxy davanti usa
# 1 (meglio di `true`: limita lo spoofing di X-Forwarded-For). Il proxy deve
# preservare l'header `Host` e aggiungere `X-Forwarded-For`/`-Proto`.
# Dietro HTTPS imposta anche `PUBLIC_URL=https://...` e `COOKIE_SECURE=true`.
TRUST_PROXY=false

DATABASE_PATH=data/dnd.db
UPLOAD_DIR=data/uploads
CLIENT_DIST=client/dist/browser
MAX_UPLOAD_MB=20
# Limite di ogni body JSON, import della campagna compreso.
MAX_JSON_MB=2
WS_RATE_LIMIT_MAX=60
LOG_LEVEL=info

# Solo per il profilo TLS opzionale di Docker Compose (deploy/Caddyfile).
# DND_PUBLIC_HOST=dnd.lan
