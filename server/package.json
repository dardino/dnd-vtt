{
  "name": "@dnd-vtt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "check:bundles": "node scripts/check-bundles.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench:scene-action": "tsx scripts/bench-scene-action.ts",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:reset": "tsx src/db/reset-cli.ts",
    "db:check": "drizzle-kit check",
    "hash:password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@dnd-vtt/shared": "0.1.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.7",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.7",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "sharp": "0.35.5",
    "uuid": "14.0.3",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
